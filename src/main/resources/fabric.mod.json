{
  "schemaVersion": 1,
  "id": "prisma",
  "version": "${version}",
  "name": "Prisma",
  "description": "Native Metal Ray Traced Shader Loader for Apple Silicon.",
  "authors": [
    "ahlansantos - shader code",
    "kokodio - main base",
    "xtarlint - Metallum 26.3 Port"
  ],
  "contact": {
    "homepage": "https://github.com/ahlansantos/Prisma",
    "sources": "https://github.com/ahlansantos/Prisma"
  },
  "license": "MIT",
  "icon": "assets/prisma/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.prisma.Prisma"
    ],
    "sodium:config_api_user": [
      "com.prisma.config.PrismaSodiumConfig"
    ]
  },
  "mixins": [
    "prisma.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.3-",
    "java": ">=25",
    "sodium": ">=0.9.2"
  },
  "breaks": {
    "iris": "*"
  }
}